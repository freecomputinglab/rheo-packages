use flake

# dist/ is gitignored, so a fresh checkout (or one cleaned after testing) has
# nothing for @rheo/tooltip:0.1.0 to resolve to until `just build` runs.
# Unlike rookery's pure-Typst build, this one is pnpm+vite — not free — so
# only run it when the output is actually missing, not on every reload.
if [ ! -f dist/my-tooltip.js ]; then
  just build > /dev/null 2>&1 || true
fi
