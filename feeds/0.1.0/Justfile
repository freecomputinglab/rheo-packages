default:
    @echo "feeds: pure Typst package, entrypoint is src/lib.typ directly — nothing to build"

# Unit fixture for the entry model, feed config, and `resolve-entries`. No
# runner: `assert`/`assert.eq` inside `test/units.typ` fail the compile with a
# line number, and a passing compile is the green light.
#
# `--root .` so the fixture's `#import "/src/lib.typ"` resolves against THIS
# package. `--features html` is kept for parity with this repo's other
# Justfiles (rookery's `test:` needs it because its `src/lib.typ` reads
# `std.target` at import time) even though this package's `src/lib.typ` reads
# no target and no rheo context at all — see its own header comment.
# `--format pdf` with a `/dev/null` output because typst cannot infer a
# format from that path, and nothing here is rendered — only asserted.
test:
    typst compile --features html --root . --format pdf test/units.typ /dev/null
    @echo "units OK"

# NOT WIRED INTO CI, and the reason is the rheo VERSION, not rheo's absence:
# CI can install a rheo release (it pins 0.5.2 for rookery's demo), but this
# package needs rheo >= 0.6.0, which is unreleased. Until it ships there is no
# release for CI to install, so this stays a local check run against a built
# `feat/transclusion` binary.
#
# It proves the headline capability — ONE project, TWO Atom feeds, the second
# sourced from `@rheo/rookery`'s `ideas(tags:)`. On a rheo below the floor the
# package's own guard now stops the build with a legible message instead of
# quietly writing no feed; see `_assert-rheo-floor` in src/lib.typ and the
# readme's "## Requirements".
demo:
    rheo compile demo

# Asserts on the OUTPUT, not merely that the build succeeded — every assertion
# in `demo/check.sh` exists only under the unreleased rheo >= 0.6.0 this demo
# needs and none of it is covered by `just test`. MEASURED on rheo 0.5.2 before
# the package guard existed: the build EXITED 0 and this script then failed on
# a missing `feed.xml`, a surviving `.rheo/`, and every page's autodiscovery
# link — which is why the guard fails the compile instead.
check: demo
    ./demo/check.sh

# Pins the retired Rust Atom generator's parity matrix (bead
# rheo-packages-parity-qrd) that `demo`/`check` above cannot exercise
# without changing what that demo demonstrates — a required `title`
# failing the build, a project that imports the package but never
# `configure`s it, and per-entry overrides composed over `spine()`. Same
# unreleased-rheo requirement as `demo`/`check` — see verify/*/rheo.toml and
# this package's readme.md. Builds its own fixtures (`verify/run.sh` does,
# unlike `check` above), since a couple of them are SUPPOSED to fail.
verify:
    ./verify/run.sh
