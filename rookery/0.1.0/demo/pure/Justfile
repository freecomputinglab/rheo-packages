default:
    @echo "demo/pure: run 'just watch' to live-rebuild root.typ as HTML"

# --features html is required always (epic decision 8) — see root.typ. `mkdir`
# first: unlike `rheo watch`, `typst watch` does not create its output
# directory and fails with "No such file or directory" on a fresh checkout
# (build/ is gitignored, never committed).
watch:
    mkdir -p build
    typst watch --features html --format html --root ../.. root.typ build/root.html
