# rheo, unlike typst, is NOT in this repo's devShell — it is the sibling
# `rheo/` crate, installed with `cargo install --path ../../../../rheo`. So this
# demo is a LOCAL check: the CI check workflow runs `demo/pure` (plain typst)
# and skips this one until rheo is installable there. A demo nobody can run is
# worse than none, so it stays runnable by hand rather than being wired to
# something absent.
build:
    rheo compile .

watch:
    rheo watch .

# Asserts on the OUTPUT, not merely that the build succeeded — every path below
# exists only under rheo and none of it is covered by `demo/pure`.
check: build
    ./check.sh
